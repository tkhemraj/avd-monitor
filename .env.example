# ── App ──────────────────────────────────────────
APP_TITLE=AVD Pressure Monitor
PORT=8000
REFRESH_INTERVAL_SECONDS=30

# Set to false to use live Azure data
DEMO_MODE=true

# ── Azure (required when DEMO_MODE=false) ────────
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=your-resource-group
AZURE_HOST_POOL=your-host-pool-name
